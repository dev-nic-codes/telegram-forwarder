[Unit]
Description=Telegram Forwarder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=forwarder
Group=forwarder
UMask=0077
WorkingDirectory=/opt/telegram-forwarder
EnvironmentFile=/etc/telegram-forwarder.env
ExecStart=/opt/telegram-forwarder/.venv/bin/python /opt/telegram-forwarder/run_service.py --allow-risky
Restart=always
RestartSec=10
TimeoutStopSec=35
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/telegram-forwarder

[Install]
WantedBy=multi-user.target
